# ============================================================
# MODE LOKAL (default) — kosongkan semua untuk memakai ini
# Data tersimpan di localStorage + IndexedDB browser.
# ============================================================

# ============================================================
# MODE SERVER (direkomendasikan untuk 2–5 orang)
# Kredensial HANYA di server (Vercel Function), tidak di browser.
# ============================================================
# Aktifkan mode server:
VITE_USE_SERVER_DB=0

# Dipakai api/state.js (TANPA prefix VITE_):
SUPABASE_URL=https://zhkswftjzddnmlqdiupp.supabase.co
SUPABASE_SECRET_KEY=

# ============================================================
# MODE KLIEN (alternatif) — pakai anon/publishable PUBLIC key, BUKAN secret
# Format yang diterima: sb_publishable_... (atau anon key lama).
# Salin file ini ke .env (di-gitignore) lalu isi nilai di bawah.
# ============================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
